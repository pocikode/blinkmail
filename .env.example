# Blinkmail environment configuration example.
#
# Copy to .env (which is git-ignored) and fill in real values:
#   cp .env.example .env
#
# Every placeholder below MUST be changed. The application refuses to start
# without valid domains, a strong inbound secret, and — on a fresh database — an
# initial web UI password.
#
# Variable names carry no prefix: the bare names below are exactly what the
# application reads from the environment.

# ---- Public identity ----
# APP_NAME — user-visible application name shown in the web UI.
APP_NAME=Blinkmail

# MAIL_DOMAINS — comma-separated list of mail domains this instance serves. The
# first entry is the default shown when creating an address. Use YOUR real
# domains, and make sure Cloudflare Email Routing is enabled for each one.
MAIL_DOMAINS=mail.example.com,mail.example.org

# ---- Web UI login ----
# INITIAL_PASSWORD — the admin password for the web UI, used ONCE on the first
# start to seed the password. There is a single admin account and no username.
#
#   * On a fresh database it is required: the app refuses to start without it.
#   * Once a password exists it is IGNORED (logged at debug level), so changing
#     this value later does NOT reset the password. Change the password from the
#     UI instead: Settings → Change password.
#
# Minimum 8 characters. It is stored only as a PBKDF2-SHA256 hash (600k
# iterations, random 32-byte salt) and is never written to the logs.
#
# Leave it empty (or delete the line) after the first start; it is not a secret
# the running server keeps reading. If you forget the password there is no reset
# command — see the README's Troubleshooting section.
INITIAL_PASSWORD=replace-with-a-strong-password-min-8-chars

# ---- Inbound mail ingestion ----
# INBOUND_SECRET — shared secret the Email Worker presents as
# "Authorization: Bearer <secret>" when calling POST /api/inbound. The SAME value
# must be set as the relay Worker's INBOUND_SECRET binding, which is a Wrangler
# secret (npx wrangler secret put INBOUND_SECRET).
#
# Generate a strong one with:
#   openssl rand -hex 32
#
# The application refuses to start if this is missing or shorter than 32
# characters, because an unauthenticated endpoint would accept mail from anyone.
INBOUND_SECRET=replace-me-with-openssl-rand-hex-32-output-64-chars

# MAX_INBOUND_BYTES — maximum accepted raw MIME size in bytes. Keep this equal to
# the relay Worker's MAX_RAW_BYTES so both sides agree. Default 25 MiB = 26214400.
MAX_INBOUND_BYTES=26214400

# ---- Server / storage (usually left at defaults) ----
# LISTEN_ADDR — listen address inside the container. Leave as :8080 unless you
# change the published port in docker-compose.yml.
LISTEN_ADDR=:8080

# DATA_DIR — directory holding persistent data. The database always lives at
# $DATA_DIR/db.sql; there is no separate database path setting. /data is the
# mounted named volume.
DATA_DIR=/data

# LOG_LEVEL — log verbosity: debug, info, warn, or error.
LOG_LEVEL=info
