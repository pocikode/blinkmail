# Blinkmail environment configuration example.
#
# Copy to .env (which is git-ignored) and fill in real values:
#   cp .env.example .env
#
# Every placeholder below MUST be changed. The application refuses to start
# without valid domains and a strong inbound secret.

# ---- Public identity ----
# User-visible application name shown in the web UI.
BLINKMAIL_APP_NAME=Blinkmail

# Comma-separated list of mail domains this instance serves. The first entry is
# the default shown when creating an address. Use YOUR real domains, and make
# sure Cloudflare Email Routing is enabled for each one.
BLINKMAIL_MAIL_DOMAINS=mail.example.com,mail.example.org

# Public host of the web UI, displayed to users (no scheme).
BLINKMAIL_WEB_HOST=mail.example.com

# ---- Inbound mail ingestion ----
# Shared secret the Email Worker presents as "Authorization: Bearer <secret>"
# when calling POST /api/inbound. The SAME value must be set as a Wrangler
# secret on the relay Worker (npx wrangler secret put INBOUND_SECRET).
#
# Generate a strong one with:
#   openssl rand -hex 32
#
# The application refuses to start if this is missing or shorter than 32
# characters, because an unauthenticated endpoint would accept mail from anyone.
BLINKMAIL_INBOUND_SECRET=replace-me-with-openssl-rand-hex-32-output-64-chars

# Maximum accepted raw MIME size in bytes. Keep this equal to the relay
# Worker's MAX_RAW_BYTES so both sides agree. Default 25 MiB = 26214400.
BLINKMAIL_MAX_INBOUND_BYTES=26214400

# ---- Server / storage (usually left at defaults) ----
# Listen address inside the container. Leave as :8080 unless you change the
# published port in docker-compose.yml.
BLINKMAIL_LISTEN_ADDR=:8080

# SQLite database path. /data is the mounted named volume.
BLINKMAIL_DB_PATH=/data/blinkmail.db

# Log verbosity: debug, info, warn, or error.
BLINKMAIL_LOG_LEVEL=info
